# Copy file này thành .env rồi sửa lại giá trị (KHÔNG commit file .env)

NODE_ENV=development
PORT=3000

# Địa chỉ public để tạo URL ảnh, ví dụ http://<IP-VPS>:3000
PUBLIC_BASE_URL=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dating_app
DB_PASSWORD=change_me
DB_NAME=dating_app

# JWT - tạo chuỗi ngẫu nhiên bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Cho phép Web Admin gọi API (phân cách bằng dấu phẩy, * = tất cả)
CORS_ORIGINS=*

# ---- Email (OTP quên mật khẩu) ----
# console = in email ra log server (pm2 logs dating-api); smtp = gửi thật
MAIL_PROVIDER=console
# Gửi bằng Gmail: bật xác minh 2 bước -> tạo App Password -> điền vào SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DateZone <your.account@gmail.com>

# ---- Số điện thoại: TẠM NGỪNG đăng ký / đăng nhập bằng SĐT (true để bật lại) ----
PHONE_AUTH_ENABLED=false

# ---- OTP (dùng chung email + SMS) ----
# Chưa có nhà mạng SMS: mã OTP được in ra log server (pm2 logs dating-api)
SMS_PROVIDER=console
# true = trả mã OTP trong response (field "devOtp") để test bằng Postman / app. Tắt khi đã gửi email thật!
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5
# Đăng nhập bằng SĐT + mật khẩu xong có phải nhập OTP không
LOGIN_OTP_REQUIRED=true
# Số ảnh tối thiểu để hoàn tất hồ sơ (đặt 0 khi test bằng Postman không muốn upload ảnh)
ONBOARDING_MIN_PHOTOS=2
