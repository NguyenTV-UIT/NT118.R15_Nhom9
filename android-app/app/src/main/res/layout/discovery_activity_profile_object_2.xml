<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileDetailRoot2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Header top bar -->
    <LinearLayout
        android:id="@+id/profileDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnProfileBack"
            style="@style/AuthBackButton" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Thông tin hồ sơ"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                style="@style/AuthLogoImage"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                style="@style/AuthLogoTitle"
                android:layout_width="wrap_content"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/profileDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ảnh bìa / Ảnh đại diện chính -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivProfileCover"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:contentDescription="Ảnh bìa hồ sơ"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/discovery_profile_placeholder" />

            <!-- Thẻ nội dung chi tiết -->
            <LinearLayout
                android:id="@+id/profileDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_auth_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <!-- Tên và Tuổi -->
                <TextView
                    android:id="@+id/tvProfileNameAge"
                    style="@style/AuthCardTitle"
                    android:text="Trương Vĩnh Nguyên, 20"
                    android:textSize="24sp" />

                <!-- Thông tin cơ bản: Chiều cao, Cân nặng, Giới tính -->
                <TextView
                    android:id="@+id/tvProfileGender"
                    style="@style/AuthCardSubtitle"
                    android:layout_marginTop="6dp"
                    android:text="Chiều cao 170 cm  Cân nặng 65 kg  Giới tính Nam"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Vị trí & Khoảng cách -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProfileLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:text="Thành phố Hồ Chí Minh  Cách bạn 1,2 km"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/n_ic_location" />

                </LinearLayout>

                <!-- Giới thiệu bản thân (Bio) -->
                <TextView
                    style="@style/ProfileSectionTitle"
                    android:layout_marginTop="24dp"
                    android:text="Giới thiệu bản thân" />

                <TextView
                    android:id="@+id/tvProfileBio"
                    style="@style/AuthCardSubtitle"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Thích du lịch, cà phê và trải nghiệm các địa điểm mới. Mong muốn kết nối với những người bạn tích cực và chân thành." />

                <!-- Các thông tin chi tiết hồ sơ -->
                <TextView
                    android:id="@+id/tvProfilePersonalInfoTitle"
                    style="@style/ProfileSectionTitle"
                    android:layout_marginTop="24dp"
                    android:text="Thông tin cá nhân" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileGoal"
                        style="@style/AuthCardSubtitle"
                        android:text="Mục tiêu: Mối quan hệ nghiêm túc" />

                    <TextView
                        android:id="@+id/tvProfileZodiac"
                        style="@style/AuthCardSubtitle"
                        android:layout_marginTop="4dp"
                        android:text="Cung hoàng đạo: Sư Tử" />

                    <TextView
                        android:id="@+id/tvProfileSmoking"
                        style="@style/AuthCardSubtitle"
                        android:layout_marginTop="4dp"
                        android:text="Hút thuốc: Không hút thuốc" />

                    <TextView
                        android:id="@+id/tvProfileDrinking"
                        style="@style/AuthCardSubtitle"
                        android:layout_marginTop="4dp"
                        android:text="Rượu bia: Thỉnh thoảng uống" />

                    <TextView
                        android:id="@+id/tvProfileExercise"
                        style="@style/AuthCardSubtitle"
                        android:layout_marginTop="4dp"
                        android:text="Tập luyện: Tập vài lần mỗi tuần" />

                    <TextView
                        android:id="@+id/tvProfileEducation"
                        style="@style/AuthCardSubtitle"
                        android:layout_marginTop="4dp"
                        android:text="Học vấn: Đại học" />

                </LinearLayout>

                <!-- Sở thích -->
                <TextView
                    style="@style/ProfileSectionTitle"
                    android:layout_marginTop="24dp"
                    android:text="Sở thích" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupProfileInterests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp"
                    app:singleLine="false"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        style="@style/InterestChip"
                        android:checkable="false"
                        android:clickable="false"
                        android:text="Du lịch" />

                    <com.google.android.material.chip.Chip
                        style="@style/InterestChip"
                        android:checkable="false"
                        android:clickable="false"
                        android:text="Âm nhạc" />

                    <com.google.android.material.chip.Chip
                        style="@style/InterestChip"
                        android:checkable="false"
                        android:clickable="false"
                        android:text="Cà phê" />

                    <com.google.android.material.chip.Chip
                        style="@style/InterestChip"
                        android:checkable="false"
                        android:clickable="false"
                        android:text="Ẩm thực" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Album ảnh cá nhân -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ProfileSectionTitle"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:text="Album ảnh" />

                    <TextView
                        android:id="@+id/btnProfileViewAllPhotos"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="Xem tất cả ảnh"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Lưới ảnh đại diện -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/profilePhotoGallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/profileGalleryCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileGalleryCard1"
                        style="@style/ProfileGalleryCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toStartOf="@id/profileGalleryCenter"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivProfileGalleryPhoto1"
                            style="@style/ProfileGalleryImage"
                            android:contentDescription="Ảnh album 1" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileGalleryCard2"
                        style="@style/ProfileGalleryCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="4dp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/profileGalleryCenter"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivProfileGalleryPhoto2"
                            style="@style/ProfileGalleryImage"
                            android:contentDescription="Ảnh album 2" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileGalleryCard3"
                        style="@style/ProfileGalleryCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toStartOf="@id/profileGalleryCenter"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/profileGalleryCard1">

                        <ImageView
                            android:id="@+id/ivProfileGalleryPhoto3"
                            style="@style/ProfileGalleryImage"
                            android:contentDescription="Ảnh album 3" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileGalleryCard4"
                        style="@style/ProfileGalleryCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/profileGalleryCenter"
                        app:layout_constraintTop_toBottomOf="@id/profileGalleryCard2">

                        <ImageView
                            android:id="@+id/ivProfileGalleryPhoto4"
                            style="@style/ProfileGalleryImage"
                            android:contentDescription="Ảnh album 4" />
                    </androidx.cardview.widget.CardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Đường kẻ phân cách phía dưới -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="28dp"
                    android:background="@color/border_input" />

                <!-- Các nút Chặn & Báo cáo ở cuối trang -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Nút Chặn người này -->
                    <TextView
                        android:id="@+id/btnBlockUser"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/n_bg_birthday"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Chặn người này"
                        android:textColor="@color/brand_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Nút Báo cáo người này -->
                    <TextView
                        android:id="@+id/btnReportUser"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/n_bg_birthday"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="Báo cáo người này"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- THANH NÚT TƯƠNG TÁC ĐỐI TƯỢNG Ở ĐÁY (Thích bên phải, Từ chối bên trái) -->
    <LinearLayout
        android:id="@+id/profileBottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/white"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp">

        <!-- Nút Từ chối / Pass (X bên trái) -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPass"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/discovery_pass"
            android:elevation="6dp"
            android:padding="16dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_remove"
            app:tint="@color/discovery_pass_orange" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Nút Thích / Like (Trái tim bên phải) -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnLike"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_add"
            android:contentDescription="@string/discovery_like"
            android:elevation="10dp"
            android:padding="18dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_discovery_heart"
            app:tint="@color/white" />

    </LinearLayout>

</LinearLayout>
