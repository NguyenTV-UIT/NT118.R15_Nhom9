      "name": "1. Auth",
      "item": [
        {
          "name": "Đăng nhập (An)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"an@demo.local\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const d = pm.response.json().data;",
                  "if (d && d.tokens) {",
                  "  pm.collectionVariables.set('accessToken', d.tokens.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.tokens.refreshToken);",
                  "  pm.collectionVariables.set('myId', d.user ? d.user.id : '');",
                  "  console.log('Đã lưu token của', d.user && d.user.email);",
                  "}"
                ]
              }
            }
          ]
        },
