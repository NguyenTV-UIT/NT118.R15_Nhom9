# Copy file này thành .env rồi sửa lại giá trị (KHÔNG commit file .env)

NODE_ENV=development
PORT=3000

# Địa chỉ public để tạo URL ảnh, ví dụ http://<IP-VPS>:3000
PUBLIC_BASE_URL=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dating_app
DB_PASSWORD=change_me
DB_NAME=dating_app

# JWT - tạo chuỗi ngẫu nhiên bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Cho phép Web Admin gọi API (phân cách bằng dấu phẩy, * = tất cả)
CORS_ORIGINS=*

# ---- Email (OTP quên mật khẩu) ----
# console = in email ra log server (pm2 logs dating-api); smtp = gửi thật
MAIL_PROVIDER=console
# Gửi bằng Gmail: bật xác minh 2 bước -> tạo App Password -> điền vào SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DateZone <your.account@gmail.com>

# ---- Số điện thoại: TẠM NGỪNG đăng ký / đăng nhập bằng SĐT (true để bật lại) ----
PHONE_AUTH_ENABLED=false

# ---- OTP (dùng chung email + SMS) ----
# Chưa có nhà mạng SMS: mã OTP được in ra log server (pm2 logs dating-api)
SMS_PROVIDER=console
# true = trả mã OTP trong response (field "devOtp") để test bằng Postman / app. Tắt khi đã gửi email thật!
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5
# Đăng nhập bằng SĐT + mật khẩu xong có phải nhập OTP không
LOGIN_OTP_REQUIRED=true
# Số ảnh tối thiểu để hoàn tất hồ sơ (đặt 0 khi test bằng Postman không muốn upload ảnh)
ONBOARDING_MIN_PHOTOS=2

# ---- OTP email tuỳ chọn (mặc định TẮT để khớp app hiện tại; app đọc cấu hình ở GET /api/meta/options -> auth) ----
# true = đăng ký phải nhập OTP gửi tới email (POST /auth/register/send-otp rồi gửi kèm "otp" khi register)
REGISTER_OTP_REQUIRED=false
# true = đăng nhập email + mật khẩu xong phải nhập OTP (POST /auth/login/verify-otp)
EMAIL_LOGIN_OTP_REQUIRED=false
# true = đổi email phải nhập thêm OTP gửi tới email MỚI (POST /users/me/email/confirm)
EMAIL_CHANGE_VERIFY_NEW=false

# ---- Chat & cuộc gọi ----
# Thời gian đổ chuông tối đa (giây), quá thì thành cuộc gọi nhỡ
CALL_RING_SECONDS=45
# Máy chủ STUN/TURN cho WebRTC (JSON). Bỏ trống = STUN công cộng của Google (đủ để demo trong cùng mạng / đa số mạng wifi).
# 2 máy ở 2 mạng 4G khác nhau thường cần TURN, ví dụ:
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:<IP-VPS>:3478"],"username":"datezone","credential":"<mật khẩu>"}]
ICE_SERVERS=

# ---- Thông báo đẩy ----
# console = chỉ ghi log "[push] ..." (chưa gửi thật). Gửi thật qua Firebase: xem src/services/push.js
PUSH_PROVIDER=console
