<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/changePasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/filters_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Bar Back Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnChangePasswordBack"
            style="@style/AuthBackButton"
            android:layout_gravity="center_vertical|start" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Logo Date Zone -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Date Zone Logo"
                android:src="@drawable/ic_date_zone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Date Zone"
                android:textColor="@color/brand_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Card Đổi mật khẩu -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đổi mật khẩu"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChangePasswordSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Nhập mật khẩu hiện tại và mật khẩu mới để bảo vệ tài khoản."
                        android:textColor="#666668"
                        android:textSize="13sp" />

                    <TextView
                        style="@style/AuthFieldLabel"
                        android:layout_marginTop="16dp"
                        android:text="Mật khẩu hiện tại"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp">

                        <EditText
                            android:id="@+id/edtCurrentPasswordInput"
                            style="@style/AuthInputEditText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_search_input_active"
                            android:hint="••••••••"
                            android:inputType="textPassword"
                            android:paddingStart="16dp"
                            android:paddingEnd="48dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="#9CA3AF"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/btnTogglePasswordVisibility"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Ẩn hiện mật khẩu"
                            android:padding="6dp"
                            android:src="@drawable/ic_profile_eye"
                            app:tint="#666668" />

                    </FrameLayout>

                    <TextView
                        style="@style/AuthFieldLabel"
                        android:layout_marginTop="16dp"
                        android:text="Mật khẩu mới" />
                    <EditText
                        android:id="@+id/edtChangeNewPassword"
                        style="@style/AuthInputEditText"
                        android:hint="Ít nhất 6 ký tự"
                        android:inputType="textPassword" />
                    <TextView
                        style="@style/AuthFieldLabel"
                        android:layout_marginTop="16dp"
                        android:text="Nhập lại mật khẩu mới" />
                    <EditText
                        android:id="@+id/edtChangeConfirmPassword"
                        style="@style/AuthInputEditText"
                        android:hint="Nhập lại mật khẩu mới"
                        android:inputType="textPassword" />
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSendOtpChangePassword"
                        style="@style/AuthPrimaryButton"
                        android:layout_marginTop="20dp"
                        android:text="Đổi mật khẩu" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Link Quên mật khẩu hiện tại? Đặt lại mật khẩu -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quên mật khẩu hiện tại? "
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnForgotPasswordLink"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:text="Đặt lại mật khẩu"
                    android:textColor="#3B82F6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
